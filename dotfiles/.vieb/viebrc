set followelement=["url","onclick","inputs-insert","inputs-click"]
" Show a loading line under the navbar as well as the tab spinner.
" The theme styles #loading-progress; Vieb only toggles that element
" for loadingindicator=line or =all.
set loadingindicator=all
" Open new tabs in the background (middle-click a link, or follow mode's
" new-tab variant). Written as explicit =false rather than the '!' toggle
" form: ':reloadconfig' re-runs this file without resetting defaults, so a
" toggle flips the value on every reload.
set follownewtabswitch=false
set mousenewtabswitch=false
set splitright
set permissioncertificateerror=ask
" make esc behave like it were entered in insert mode
set passthroughkeys={".*": "<Esc>"}

